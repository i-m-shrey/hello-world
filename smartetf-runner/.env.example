# Runner Service Environment Variables

# Database (same as backend)
DB_URL=postgresql+pg8000://user:password@host:6543/postgres

# Runner Configuration
RUN_MODE=headless
WINDOW_MINUTES=3
LOCK_MINUTES=15
ONCE_PER_DAY=1
RUNNER_TOKEN=shared-secret-token-here

# Trading Configuration
BASE_MONTHLY=8000
MULTIPLIER_MIN=0.5
MULTIPLIER_MAX=10.0
ADMIN_EMAIL=admin@yourdomain.com

# Broker API Credentials - Finvasia
FINVASIA_VENDOR_CODE=your-vendor-code
FINVASIA_API_SECRET=your-api-secret
FINVASIA_IMEI=api-device

# Broker API Credentials - Zerodha (if needed)
ZERODHA_API_KEY=your-api-key
ZERODHA_API_SECRET=your-api-secret

# Broker API Credentials - Dhan (if needed)
DHAN_CLIENT_ID=your-client-id
DHAN_ACCESS_TOKEN=your-access-token

# Email for notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Feature Flags
ENABLE_MONTHLY_DB=1
