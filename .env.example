# Backend Service Environment Variables

# Database
DB_URL=postgresql+pg8000://user:password@host:6543/postgres

# Flask
SECRET_KEY=your-secret-key-here
APP_BASE_URL=https://your-backend-service.run.app

# Runner Connection Configuration

# CHOOSE ONE OPTION BASED ON YOUR SETUP:

# Option 1: Local Runner (Current Setup - $0/month)
# If runner is on your local machine 24/7:
# RUNNER_URL=http://your-local-ip:8080
# OR with ngrok:
# RUNNER_URL=https://your-ngrok-url.ngrok.io
# OR with cloudflare tunnel:
# RUNNER_URL=https://your-tunnel-url.trycloudflare.com

# Option 2: Cloud Runner (Switch when needed - $15-30/month)
# If runner is deployed to Cloud Run:
# RUNNER_URL=https://smartetf-runner-xxx.a.run.app

RUNNER_URL=http://YOUR_LOCAL_IP:8080
RUNNER_TOKEN=your-shared-secret-token

# Payment Gateway
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ADMIN_EMAIL=admin@yourdomain.com

# Trading Configuration
TEST_ORDER_SYMBOL=PHARMABEES
TEST_ORDER_QTY=1
BASE_MONTHLY=8000
MULTIPLIER_MIN=0.5
MULTIPLIER_MAX=10.0

# Features
ENABLE_MONTHLY_DB=1
HEALTHCHECK_TOKEN=your-healthcheck-token

# Performance (for Cloud Run)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# To reduce cold starts on free tier:
# - Set min instances to 1 (costs ~$5/month but eliminates cold starts)
# - Or use Cloud Scheduler to ping /health every 5 minutes during business hours
